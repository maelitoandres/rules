rules:
# ══════════════════════════════════════════════════════════════
# 运营设备专属出口 —— 一台设备一个 IP
#   @@OPS_IP1@@ → 🇨🇴 运营01   社媒 app 走专属出口，其余流量走本地
#   @@OPS_IP2@@ → 🇨🇴 运营02   全部流量走专属出口（专机专用，兜底规则见 _2.list）
# ══════════════════════════════════════════════════════════════
#
# ★ 组织方式：按 app 分组，同一 app 下集中所有设备的规则。
#   这样加新 app 时只需在一处新增一个区块，检查某个 app 的覆盖是否完整
#   也能一眼看全。加新设备时虽要在各区块内追加，但那是低频操作。
#
# ★ 规则直接指向【节点名】而非策略组：
#   出口因此固定不变，不受面板切换影响，也不会在重新生成配置时被重置
#   （策略组的选择会被重置，写死在规则里的节点名不会）。
#   运营链路必须避开一切会被重置的东西。
#
# ★ 每个 app 都要带上自建补充规则集：
#   只写 RULE-SET,Weibo 是不够的，CO_weibo_rule 里的关键字和 CDN IP 段
#   不会跟着走专属出口，同一 app 的流量会分走两个 IP —— 对运营账号而言
#   这比 IP 不对更容易触发风控。
#
# ⚠️ 依赖【设备端设置的静态 IP】，不是 DHCP 保留。若设备离线、换机或改了
#    地址，该 IP 可能被 DHCP 分配给别的设备，那台设备的社媒流量就会误走
#    运营出口，污染这个 IP 的行为画像。
#    建议在 DHCP 里对 MAC 做静态绑定，并把地址排除出动态池。
#
# ⚠️ 本文件的规则插在配置 rules 的【最顶部】，优先级高于所有 ruleset。
#
# ⚠️ 改节点名后必须同步这里 —— 目标名是写死的字符串，节点改名后规则会被
#    静默丢弃（日志打 Skiped The Custom Rule），运营流量退回策略组也就是
#    DIRECT，直接暴露真实 IP。改完务必检查:
#      grep -c "Skiped The Custom Rule" /tmp/openclash.log    # 应为 0

#—— 抖音 ——
# CO_douyin_rule 含字节系域名、关键字兜底、以及 PCDN 域名
# ★ 抖音/小红书 CDN 走 📦CDN 策略组(默认日本, 提速, 不影响属地) —— 2026-08-22 重构
#   把 CDN 内容流集中到 rule/CO/CO_cdn_rule.yaml 规则集(抖音: douyinvod/zjcdn/
#   douyinpic/byteimg/huoshanimg; 小红书: xhscdn.com), 由 📦CDN 策略组(默认🇯🇵日本)
#   统一管理, 面板切 📦CDN 即可改所有 CDN 走向。
#   原因: 哥伦比亚 Decodo 住宅代理高并发建连能力有限(实测短超时3s+并发30 下运营01
#   93-100% 超时、CN2GIA 0%)。抖音/小红书刷内容瞬间开几十个 CDN 连接把 Decodo
#   挤爆 → 视频/图片/搜索加载失败。分流 CDN 走日本, Decodo 只剩少量 API 并发就扛住。
#   不影响属地: 属地看【发布/评论】API 的出口 IP(仍走运营01 哥伦比亚), CDN 只是拉内容。
#   ⚠️ webcast(直播互动)、bytegecko(PCDN/P2P)、amemv 与 xiaohongshu.com 的
#      API/埋点【都不在】CO_cdn_rule 里, 仍走运营01 保属地。
#   ⚠️ ini 的 ruleset=📦 CDN 是全局规则(其他设备的这些 CDN 也走 📦CDN=默认日本);
#      下面 AND 给运营设备明确绑定, 排在抖音/小红书 AND 之前, 优先走 📦CDN。
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,CO_cdn_rule)),📦 CDN
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,CO_cdn_rule)),📦 CDN
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,DouYin)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,CO_douyin_rule)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,DouYin)),🇨🇴 运营02
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,CO_douyin_rule)),🇨🇴 运营02

#—— 小红书 ——
# CO_xhs_rule 含 IP-ASN,139341(ACE CDN) 与阿里云海外三段
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,XiaoHongShu)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,CO_xhs_rule)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,XiaoHongShu)),🇨🇴 运营02
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,CO_xhs_rule)),🇨🇴 运营02

#—— 微博 ——
# CO_weibo_rule 含 sinaimg 等关键字与 EdgeNext/Zenlayer CDN 段
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,Weibo)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,CO_weibo_rule)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,Weibo)),🇨🇴 运营02
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,CO_weibo_rule)),🇨🇴 运营02

#—— TikTok ——
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,TikTok)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,TikTok)),🇨🇴 运营02

#—— 微信（含视频号）——
# 必须同时覆盖 WeChat 与 CO_wechat_rule: 视频号的评论/点赞/发布走微信主体的
# mmtls 长连接(szextshort/szlong/szshort)，视频号自己的域名只负责拉视频画面。
# 只覆盖 CO_wechat_rule 的结果是「视频从境外拉，评论仍从真实 IP 提交」。
#
# ⚠️ 副作用: 这两台设备的微信【全部功能】都走境外 —— 聊天延迟增加约 400ms，
#    微信支付走境外 IP 可能触发风控。仅适用于专用运营小号的设备。
#    若某台设备也用于日常微信，删掉它的 WeChat 那条，只保留 CO_wechat_rule。
#- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,WeChat)),🇨🇴 运营01  # 2026-08-21 注释: .33 微信走本地日常(视频号运营时取消注释)
#- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,CO_wechat_rule)),🇨🇴 运营01  # 2026-08-21 注释: .33 微信走本地日常(视频号运营时取消注释)
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,WeChat)),🇨🇴 运营02
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,CO_wechat_rule)),🇨🇴 运营02

#—— Meta 系（Instagram / Threads / Facebook）——
# 必须整组覆盖而不能只绑 Instagram: IG 的图片视频走 fbcdn.net（收在 Meta_rule
# 里），API 走 instagram.com。只绑 Instagram 的话 API 从境外出去、媒体却从
# 美国出去，同一 app 分走两个 IP。Facebook.yaml 也要覆盖 —— 它含
# DOMAIN-SUFFIX,facebook.com，而 graph.facebook.com 是 FB/IG 共用的 API 端点。
#
# ⚠️ Meta 对数据中心 IP 的识别远比国内平台严格，Decodo 是 hosting:true 的
#    ISP 代理。首次切换请先用小号验证，可能触发验证码或账号验证。
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,Instagram)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,Threads)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,Meta_rule)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,Facebook)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,Instagram)),🇨🇴 运营02
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,Threads)),🇨🇴 运营02
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,Meta_rule)),🇨🇴 运营02
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,Facebook)),🇨🇴 运营02

#—— CO补充（跨 app 通用域名的兜底）——
# 必须覆盖，否则新加进 CO_social_rule 的域名在运营设备上不走专属出口，
# 而是跟随「🇨🇴 CO补充」组(默认 DIRECT) —— 等于漏网域名直接暴露真实 IP。
# 当前收录: 数美风控 fengkongcloud（设备指纹上报，必须与业务流量同源）。
- AND,((SRC-IP-CIDR,@@OPS_IP1@@/32),(RULE-SET,CO_social_rule)),🇨🇴 运营01
- AND,((SRC-IP-CIDR,@@OPS_IP2@@/32),(RULE-SET,CO_social_rule)),🇨🇴 运营02

# 注: WhatsApp 刻意【不】绑定运营出口。它账号绑手机号，登录 IP 跳变会触发
#     封号；且与社媒运营无关，保持走「🇺🇸 CN2GIA快线」更稳。

#—— .34 整机兜底（2026-08-21 方案③：撤销 .33 国内 IP 兜底）——
# 【为何撤】方案②(兜 .33 命中 ChinaIp/ChinaCompanyIp 的裸 IP→运营01)为堵抖音 TTNet
#   裸 IP 而"宁可错杀兜所有国内裸 IP"，结果误伤了所有用 HTTPDNS/GSLB 真实 IP 直连的
#   国内 App —— 饿了么、微信 CDN(cdn.weixin.qq.com)等的裸 IP 也被截到哥伦比亚运营01，
#   图片/视频持续卡死。这些 CDN 裸 IP 无 SNI、遍布各地电信/联通/移动 IDC、IP 多变，
#   无法用域名或固定段单独放行，方案②框架内无解，故整体撤销。
#
# 【撤销后 .33 的抖音保护仍在，靠三层】
#   1. DouYin + CO_douyin_rule 的全部【域名】→ 运营01(属地主要看 API/评论连接的出口 IP)
#   2. CO_douyin_rule 里已收录的抖音裸 IP 段(111.13.225.0/24 等)→ 运营01
#   3. 视频/图片 CDN(douyinvod/zjcdn/...)→ 日本(提速)
#   撤销后国内裸 IP(微信/饿了么/淘宝 CDN)回归本地直连(快、正常)。
#
# ⚠️ 残余风险：抖音【新出现、尚未收录】的裸 IP 段(TTNet 备用通道)会走本地直连 →
#    偶发属地泄漏。靠监控 /tmp/openclash.log 漏网之鱼里的字节裸 IP(无域名、命中 ChinaIp、
#    刷抖音时出现)，用无 SNI 证书/ASN 核实归属后补进 CO_douyin_rule 的 IP-CIDR。
#
# .34 保持整机兜底（纯运营专机：一切出公网流量走运营02。与 .33 差异有意保留——
#   .33 兼日常、精细分流；.34 专机、全量同源）。
- SRC-IP-CIDR,@@OPS_IP2@@/32,🇨🇴 运营02
